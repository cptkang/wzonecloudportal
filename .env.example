# 포탈 설정 예시 — 실제 값은 .env에 두고 커밋하지 않는다.
# list/dict 타입 필드는 JSON 형식으로 써야 한다 (CLAUDE.md Known Mistakes 1번).

# ── DB ────────────────────────────────────────────────
# PostgreSQL 17 표준 / 16 하한 (D-013)
PORTAL_DATABASE_URL=postgresql+asyncpg://portal:devpass@localhost:55432/wzoneportal

# ── 인증 (계획 09) ────────────────────────────────────
PORTAL_JWT_SECRET=change-me-to-a-long-random-string
PORTAL_JWT_EXPIRE_MINUTES=480
# 개발 HTTP 환경에서는 false, 운영 HTTPS에서는 true
PORTAL_COOKIE_SECURE=false

# 최초 기동 시 관리자 계정이 0명일 때만 사용한다. 생성 후 제거할 것 (계획 09 §7).
PORTAL_BOOTSTRAP_ADMIN_USERNAME=admin
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-1234

# ── 자격증명 암호화 (계획 10, NFR-208) ────────────────
# base64로 인코딩한 32바이트. 생성: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PORTAL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32BYTES
PORTAL_CREDENTIAL_KEY_VERSION=1
# 키 교체 중에만 사용. dict이므로 JSON으로 쓴다.
# PORTAL_CREDENTIAL_LEGACY_KEYS={"1":"base64key..."}

# ── 수집 (계획 06) ────────────────────────────────────
PORTAL_COLLECTION_TIMEOUT_SECONDS=60
PORTAL_COLLECTION_MAX_RETRIES=3
PORTAL_COLLECTION_BATCH_SIZE=500
PORTAL_COLLECTION_PAGE_SIZE=500

# ── 서버 ──────────────────────────────────────────────
PORTAL_API_HOST=127.0.0.1
PORTAL_API_PORT=8080
PORTAL_LOG_LEVEL=INFO
